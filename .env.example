# Copy this file to .env and fill in your real values.

# --- Google AI Studio / Gemini API ---
GEMINI_API_KEY=your-gemini-api-key
GOOGLE_API_KEY=your-gemini-api-key
GOOGLE_CLOUD_PROJECT=projects/000000000000
GOOGLE_CLOUD_PROJECT_NUMBER=000000000000

# --- Wirestock upload ---
WIRESTOCK_API_BASE=https://api.wirestock.io
WIRESTOCK_PROJECT_ID=your-wirestock-project-id
# Bearer token from a logged-in browser session (Authorization header). Refresh when it expires.
WIRESTOCK_TOKEN=your-wirestock-bearer-token
